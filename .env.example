# [coder-nexus] DEVELOPMENT ONLY - local developer environment variables.
# HULY_* values are personal dev credentials (plain text). Do not commit this file,
# do not reuse it for staging/production, and keep `.env` in .gitignore.
# Fill Huly credentials with `coder-nexus setup huly` or edit below (e.g. https://huly.app)
HULY_WORKSPACE_URL=
HULY_EMAIL=
HULY_PASSWORD=
HULY_SESSION_TOKEN=
HULY_WORKSPACE_ID=

# Optional: Figma Personal Access Token for read-only frame extraction
FIGMA_TOKEN=
