# [coder-nexus] DEVELOPMENT ONLY - local developer environment variables.
# HULY_* values are personal dev credentials (plain text). Do not commit .env,
# do not reuse it for staging/production. Fill it with: coder-nexus setup huly
HULY_WORKSPACE_URL=https://huly.app
HULY_EMAIL=your.email@company.com
HULY_PASSWORD=your_password
HULY_SESSION_TOKEN=
HULY_WORKSPACE_ID=
